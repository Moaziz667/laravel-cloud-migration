services:
  mysql:
    image: mysql:8.0
    container_name: mysql
    environment:
      MYSQL_ROOT_PASSWORD: {{ db_root_password }}
      MYSQL_DATABASE: {{ db_name }}
      MYSQL_USER: {{ db_username }}
      MYSQL_PASSWORD: {{ db_password }}
    command: --default-authentication-plugin=mysql_native_password --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
    ports:
      - "{{ mysql_port }}:3306"
    volumes:
      - mysql-data:/var/lib/mysql
    restart: unless-stopped
    networks:
      - laraops-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p{{ db_root_password }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 40s

  nginx:
    image: {{ nginx_image }}
    container_name: nginx
    ports:
      - "{{ nginx_port }}:80"
    volumes:
      - app-data:/var/www/html
    depends_on:
      - app
    restart: unless-stopped
    networks:
      - laraops-network

  app:
    image: {{ php_image }}
    container_name: app
    volumes:
      - app-data:/var/www/html
    env_file:
      - .env
    restart: unless-stopped
    expose:
      - "{{ php_fpm_port }}"
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - laraops-network

volumes:
  app-data:
    driver: local
  mysql-data:
    driver: local

networks:
  laraops-network:
    driver: bridge
