# This is a template for the Laravel .env file.
# The placeholders like APP_ENV, APP_KEY, DB_PASSWORD, etc. 
# will be replaced by environment variables injected during deployment.
# In our setup, these environment variables come from GitLab CI/CD variables,
# allowing different values for production, testing, or development without changing the code.
# Default values can be set with the ${VAR:-default} syntax (e.g., LOG_CHANNEL).
APP_NAME=Laravel
APP_ENV=production
APP_KEY=${APP_KEY}
APP_DEBUG=false
APP_URL=${APP_URL}

# Asset Configuration - FORCE HTTP EVERYWHERE
ASSET_URL=${ASSET_URL}
MIX_APP_URL=${MIX_APP_URL}
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT:-3306}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Cache Configuration  
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# File Storage
FILESYSTEM_DISK=local

